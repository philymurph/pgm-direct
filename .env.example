# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pgmsupply?schema=public"

# Session / auth
AUTH_SECRET="replace-with-a-long-random-string"

# Authorises the Vercel Cron job that releases expired stock reservations
CRON_SECRET="replace-with-another-long-random-string"

# Shared rate limiting for serverless/multi-instance production deployments
# Vercel's Upstash integration provides equivalent KV_REST_API_* variables.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Revolut Merchant API (https://developer.revolut.com/docs/merchant)
# Never expose REVOLUT_SECRET_KEY or REVOLUT_WEBHOOK_SECRET to the browser.
REVOLUT_ENVIRONMENT="sandbox" # sandbox | production
REVOLUT_PUBLIC_KEY=""
REVOLUT_SECRET_KEY=""
REVOLUT_WEBHOOK_SECRET=""

# Public site URL, used for absolute URLs (sitemap, structured data, emails)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Email (order confirmations, contact form routing) — configure before production use
EMAIL_FROM=""
EMAIL_CONTACT_TO=""
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT=""
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""

# Vercel Blob (product image uploads in the admin area)
BLOB_READ_WRITE_TOKEN=""
